{
  "model": {
    "type": "minecraft:composite",
    "models": [
      {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_false": {
          "type": "minecraft:select",
          "property": "minecraft:charge_type",
          "cases": [
            {
              "when": "arrow",
              "model": {
                "type": "minecraft:model",
                "model": "mastermaxisvanillaplus:item/nether_crossbow_bolt"
              }
            },
            {
              "when": "rocket",
              "model": {
                "type": "minecraft:model",
                "model": "mastermaxisvanillaplus:item/nether_crossbow_firework"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "mastermaxisvanillaplus:item/nether_crossbow"
          }
        },
        "on_true": {
          "type": "minecraft:range_dispatch",
          "property": "minecraft:crossbow/pull",
          "entries": [
            {
              "threshold": 0.58,
              "model": {
                "type": "minecraft:model",
                "model": "mastermaxisvanillaplus:item/nether_crossbow_pulling_1"
              }
            },
            {
              "threshold": 1.0,
              "model": {
                "type": "minecraft:model",
                "model": "mastermaxisvanillaplus:item/nether_crossbow_pulling_2"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "mastermaxisvanillaplus:item/nether_crossbow_pulling_0"
          }
        }
      },
      {
        "type": "minecraft:model",
        "model": "mastermaxisvanillaplus:item/viewfinder_attachment"
      }
    ]
  }
}
